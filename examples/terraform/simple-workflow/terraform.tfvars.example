# Simple workflow configuration
# Copy to terraform.tfvars and edit with your values
#
# Prerequisites:
# - Deploy coordinator module first
# - Coordinator outputs are passed via CLI (see justfile tf-with-coordinator-vars)

name_prefix = "snakemake-simple-workflow"
region      = "us-east-1"

# Compute environment settings
# The workflow has its own queue/compute environment, separate from coordinator
compute_type = "EC2"  # FARGATE, FARGATE_SPOT, EC2, or SPOT
max_vcpus    = 256    # Max vCPUs for the compute environment

# EC2/SPOT only settings (ignored for Fargate)
# instance_types = ["optimal"]
# min_vcpus      = 0

# Workflow container settings
# workflow_image defaults to ECR repo when create_ecr=true
# workflow_image = "your-custom-image:tag"  # Override if not using ECR
workflow_vcpus  = 1
workflow_memory = 2048

# ECR repository for workflow image (workflow_image defaults to this)
create_ecr = true

# Optional: Use coordinator's security group (passed via CLI from coordinator outputs)
# If not provided, a new security group will be created
# security_group_id = null

tags = {
  Environment = "dev"
}
